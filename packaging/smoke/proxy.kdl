version 1

(array)upstream_pools {
  (object)- {
    name "origin"
    algorithm "round_robin"
    (array)servers {
      (object)- {
        name "origin-1"
        (object)endpoint {
          type "socket"
          address "127.0.0.1:18081"
        }
      }
    }
  }
}

(array)http_services {
  (object)- {
    name "web"
    (array)routes {
      (object)- {
        (object)action {
          type "proxy"
          upstream_pool "origin"
          (object)policy {
          }
        }
        (object)path {
          kind "segment_prefix"
          value "/"
        }
        (object)policy {
          max_request_body_bytes 10485760
          request_buffering #false
          response_buffering #false
        }
      }
    }
  }
}

(array)listeners {
  (object)- {
    name "web"
    protocol "http"
    service "web"
    (object)bind {
      type "socket"
      address "127.0.0.1:18080"
    }
  }
}
