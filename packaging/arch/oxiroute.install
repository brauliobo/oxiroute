post_install() {
  cat <<'EOF'
OxiRoute was installed with a safe, empty configuration.

Edit /etc/oxiroute/oxiroute.kdl, then explicitly enable and start it with:
  systemctl enable --now oxiroute.service

The service is not enabled or started by this package. Operational notes and
drop-in examples are installed at:
  /usr/share/doc/oxiroute/arch-packaging.md

The legacy restricted Lua example remains available at
  /etc/oxiroute/oxiroute.lua
EOF
}

post_upgrade() {
  cat <<'EOF'
Review .pacnew files under /etc/oxiroute before restarting oxiroute.
EOF
}
