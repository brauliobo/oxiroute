{
  "name": "oxiroute-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/node": "^24.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "pug": "^3.0.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.3"
  }
}
