{
  "name": "oxiroute-ui",
  "private": true,
  "version": "6.3.1",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:stats": "vue-tsc --noEmit && vite build --config vite.stats.config.ts && pnpm verify:stats-bundle",
    "build:management": "cd .. && nice cargo +1.97.1 build -p oxiroute --bin oxiroute --locked --jobs 4",
    "dev": "vite",
    "generate:control-plane": "node ../scripts/generate-control-plane-types.mjs",
    "generate:stats-page": "node ../scripts/generate-stats-page-types.mjs",
    "verify:bundle": "node ../scripts/verify-ui-bundle.mjs dist",
    "verify:stats-bundle": "node ../scripts/verify-ui-bundle.mjs dist-stats && node ../scripts/verify-stats-budget.mjs dist-stats",
    "verify:control-plane": "node ../scripts/generate-control-plane-types.mjs --check",
    "verify:stats-page": "node ../scripts/generate-stats-page-types.mjs --check",
    "pretest": "pnpm run build:management",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit"
  },
  "dependencies": {
    "vue": "3.6.0-rc.14"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "pug": "^3.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
