#!/usr/bin/make -f
stage := $(CURDIR)/stage
root  := $(CURDIR)/debian/oxiroute

%:
	dh $@

override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_auto_install:
	install -Dm755 $(stage)/payload/bin/oxiroute $(root)/usr/bin/oxiroute
	ln -s oxiroute $(root)/usr/bin/oxr
	install -Dm755 $(stage)/payload/lib/oxiroute/oxiroute-worker-launcher $(root)/usr/lib/oxiroute/oxiroute-worker-launcher
	install -Dm644 -t $(root)/etc/oxiroute $(stage)/layout/oxiroute.env $(stage)/layout/oxiroute.kdl $(stage)/layout/oxiroute.lua
	install -Dm644 $(stage)/layout/oxiroute.modules $(root)/usr/lib/modules-load.d/oxiroute.conf
	install -Dm644 -t $(root)/usr/share/doc/oxiroute $(stage)/docs/*.md $(stage)/payload/LICENSE $(stage)/payload/BUILD-INFO.json

override_dh_installtmpfiles:
	dh_installsysusers
	dh_installtmpfiles

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_strip:
	dh_strip --no-automatic-dbgsym
